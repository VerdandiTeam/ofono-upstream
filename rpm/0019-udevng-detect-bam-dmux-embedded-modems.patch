Subject: [PATCH 1/2] udevng: detect bam-dmux embedded modems

Older Qualcomm SoCs (msm8916, msm8974) expose the integrated modem's QMI control port as an rpmsg wwan port and its data channels through the bam-dmux driver (wwan0..wwan7). Group the QMI port and wwan0 under the modem's remoteproc device and hand them to the gobi driver as an embedded modem.
---
 plugins/udevng.c | 58 +++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 57 insertions(+), 1 deletion(-)

diff --git a/plugins/udevng.c b/plugins/udevng.c
index 0d748c87..6b59365b 100644
--- a/plugins/udevng.c
+++ b/plugins/udevng.c
@@ -1712,6 +1712,37 @@ static gboolean setup_mhi(struct modem_info *modem)
 	return TRUE;
 }
 
+static gboolean setup_bamdmux(struct modem_info *modem)
+{
+	const struct device_info *net = NULL;
+	const char *qmi = NULL;
+	GSList *list;
+
+	DBG("%s", modem->syspath);
+
+	for (list = modem->devices; list; list = list->next) {
+		const struct device_info *info = list->data;
+		const char *subsystem =
+				udev_device_get_subsystem(info->udev_device);
+
+		if (l_streq0(subsystem, "wwan"))
+			qmi = udev_device_get_devnode(info->udev_device);
+		else if (l_streq0(subsystem, "net"))
+			net = info;
+	}
+
+	DBG("qmi: %s net: %p", qmi, net);
+
+	if (!qmi || !net)
+		return FALSE;
+
+	ofono_modem_set_driver(modem->modem, "gobi");
+	ofono_modem_set_string(modem->modem, "Device", qmi);
+	ofono_modem_set_string(modem->modem, "Bus", "embedded");
+
+	return setup_qmi_netdev(modem, net) == 0;
+}
+
 static struct {
 	const char *name;
 	gboolean (*setup)(struct modem_info *modem);
@@ -1755,6 +1786,7 @@ static struct {
 	{ "ehs6",	setup_ehs6		},
 	{ "qrtrsoc",	setup_qrtrsoc		},
 	{ "mhi",	setup_mhi		},
+	{ "bamdmux",	setup_bamdmux		},
 	{ }
 };
 
@@ -2433,8 +2465,20 @@ static void check_wwan_device(struct udev_device *device)
 
 	parent = udev_device_get_parent_with_subsystem_devtype(device,
 								"mhi", NULL);
-	if (!parent)
+	if (!parent) {
+		parent = udev_device_get_parent(device);
+
+		while (parent && !l_streq0(udev_device_get_driver(parent),
+							"qcom-q6v5-mss"))
+			parent = udev_device_get_parent(parent);
+
+		if (parent && strstr(udev_device_get_sysname(device), "qmi"))
+			add_device(udev_device_get_syspath(parent), NULL,
+					"bamdmux", NULL, NULL,
+					MODEM_TYPE_EMBEDDED, device, NULL);
+
 		return;
+	}
 
 	/* If this is an MHI device, find the MHI parent */
 	parent = udev_device_get_parent(parent);
@@ -2473,6 +2517,18 @@ static void check_net_device(struct udev_device *device)
 		return;
 	}
 
+	if (parent && l_streq0(udev_device_get_driver(parent), "bam-dmux")) {
+		struct udev_device *mss = udev_device_get_parent(parent);
+
+		if (mss && l_streq0(udev_device_get_sysname(device), "wwan0"))
+			add_device(udev_device_get_syspath(mss), NULL,
+					"bamdmux", NULL, NULL,
+					MODEM_TYPE_EMBEDDED, device,
+					"bam-dmux");
+
+		return;
+	}
+
 	name = udev_device_get_sysname(device);
 	if (l_str_has_prefix(name, "phonet")) {
 		add_serial_device(device);
